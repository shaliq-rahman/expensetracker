rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Existing rule for user profile data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // NEW: Allow access to root 'folders' collection
    // We check that the doc's userId matches the auth uid for updates/deletes
    // and that the creator sets their own userId on create.
    match /folders/{folderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // NEW: Allow access to root 'files' collection
    match /files/{fileId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
